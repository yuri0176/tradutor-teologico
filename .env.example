# Copie este arquivo para ".env" e coloque as suas chaves.
# Basta uma delas; com as duas, você escolhe o motor na barra lateral do app.

# Gemini (grátis, com limites diários) — crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-sua-chave-aqui

# Claude (pago por uso) — crie em https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Opcional: outros modelos.
# GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_MODEL=claude-opus-5-5

# Opcional: modelos do Gemini usados quando a cota diária do principal acaba
# (separados por vírgula; deixe vazio para desligar a troca automática).
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash
